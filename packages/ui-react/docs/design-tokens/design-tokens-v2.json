        }
      },
      "info": {
        "base": {
          "value": "--color-info",
          "description": "Info indicator. Informational messages, tips."
        },
        "fg": {
          "value": "--color-info-fg",
          "description": "Info text on neutral backgrounds."
        },
        "bg": {
          "value": "--color-info-bg",
          "description": "Info background fill. Notice containers."
        }
      }
