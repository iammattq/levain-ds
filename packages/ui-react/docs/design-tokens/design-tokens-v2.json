  "typography": {
    "_description": "Typography system with primitives and semantic styles. Use semantic utilities (.text-body, .text-heading-1, etc.) in components. Primitives (--type-*) are building blocks.",
    "primitives": {
      "families": {
        "sans": {
          "value": "--type-family-sans",
          "description": "Default sans-serif font stack for body text and UI",
          "computed": "var(--font-nunito), 'Nunito', ui-sans-serif, system-ui, -apple-system, sans-serif"
        },
        "heading": {
          "value": "--type-family-heading",
          "description": "Heading font stack. Defaults to --type-family-sans unless a typography preset sets a heading font override.",
          "computed": "var(--type-family-sans)"
        },
        "mono": {
          "value": "--type-family-mono",
          "description": "Monospace font stack for code",
          "computed": "ui-monospace, 'SF Mono', 'Cascadia Code', 'Consolas', monospace"
        }
      },
      "sizes": {
        "3xs": {
          "value": "--type-size-3xs",
          "description": "Smallest text size",
          "size": "0.625rem (10px)"
        },
        "2xs": {
          "value": "--type-size-2xs",
          "description": "Extra small text",
          "size": "0.75rem (12px)"
        },
        "xs": {
          "value": "--type-size-xs",
          "description": "Small text",
          "size": "0.875rem (14px)"
        },
        "sm": {
          "value": "--type-size-sm",
          "description": "Base text size",
          "size": "1rem (16px)"
        },
        "md": {
          "value": "--type-size-md",
          "description": "Medium text",
          "size": "1.25rem (20px)"
        },
        "lg": {
          "value": "--type-size-lg",
          "description": "Large text",
          "size": "1.5rem (24px)"
        },
        "xl": {
          "value": "--type-size-xl",
          "description": "Extra large text",
          "size": "1.75rem (28px)"
        },
        "2xl": {
          "value": "--type-size-2xl",
          "description": "2x large text",
          "size": "2rem (32px)"
        },
        "3xl": {
          "value": "--type-size-3xl",
          "description": "3x large text",
          "size": "2.25rem (36px)"
        },
        "4xl": {
          "value": "--type-size-4xl",
          "description": "4x large text",
          "size": "2.5rem (40px)"
        },
        "5xl": {
          "value": "--type-size-5xl",
          "description": "5x large text",
          "size": "2.75rem (44px)"
        },
        "6xl": {
          "value": "--type-size-6xl",
          "description": "6x large text",
          "size": "3rem (48px)"
        }
      },
      "weights": {
        "regular": {
          "value": "--type-weight-regular",
          "description": "Normal weight",
          "computed": "400"
        },
        "medium": {
          "value": "--type-weight-medium",
          "description": "Medium weight",
          "computed": "500"
        },
        "bold": {
          "value": "--type-weight-bold",
          "description": "Bold weight",
          "computed": "700"
        }
      },
      "lineHeights": {
        "none": {
          "value": "--type-leading-none",
          "description": "No extra line height",
          "computed": "1"
        },
        "tight": {
          "value": "--type-leading-tight",
          "description": "Tight line height for headings",
          "computed": "1.2"
        },
        "snug": {
          "value": "--type-leading-snug",
          "description": "Slightly tighter than normal",
          "computed": "1.375"
        },
        "normal": {
          "value": "--type-leading-normal",
          "description": "Default readable line height",
          "computed": "1.5"
        },
        "relaxed": {
          "value": "--type-leading-relaxed",
          "description": "Relaxed line height for long-form",
          "computed": "1.75"
        }
      },
      "letterSpacing": {
        "tight": {
          "value": "--type-tracking-tight",
          "description": "Tighter letter spacing for headings",
          "computed": "-0.025em"
        },
        "normal": {
          "value": "--type-tracking-normal",
          "description": "Default letter spacing",
          "computed": "0"
        },
        "wide": {
          "value": "--type-tracking-wide",
          "description": "Wider letter spacing for emphasis",
          "computed": "0.025em"
        }
      }
    },
    "semantic": {
      "_description": "Semantic typography styles. Use .type-* CSS utility classes in components (not .text-* to avoid tailwind-merge conflicts).",
      "body": {
        "class": ".type-body",
        "description": "Default body text for paragraphs and general content",
        "properties": {
          "size": "sm (16px)",
          "weight": "regular (400)",
          "leading": "normal (1.5)"
        }
      },
      "bodySm": {
        "class": ".type-body-sm",
        "description": "Smaller body text for dense content",
        "properties": {
          "size": "xs (14px)",
          "weight": "regular (400)",
          "leading": "normal (1.5)"
        }
      },
      "label": {
        "class": ".type-label",
        "description": "Form labels, buttons, navigation items",
        "properties": {
          "size": "xs (14px)",
          "weight": "medium (500)",
          "leading": "tight (1.2)"
        }
      },
      "labelSm": {
        "class": ".type-label-sm",
        "description": "Smaller labels, badge text",
        "properties": {
          "size": "2xs (12px)",
          "weight": "medium (500)",
          "leading": "tight (1.2)"
        }
      },
      "labelCompact": {
        "class": ".type-label-compact",
        "description": "Compact labels for tight spaces",
        "properties": {
          "size": "3xs (10px)",
          "weight": "medium (500)",
          "leading": "tight (1.2)"
        }
      },
      "heading1": {
        "class": ".type-heading-1",
        "description": "Page titles, primary headings (responsive)",
        "properties": {
          "family": "--type-family-heading",
          "size": "xl (28px) → 6xl (48px) at md",
          "weight": "bold (700)",
          "leading": "tight (1.2)",
          "tracking": "tight (-0.025em)"
        }
      },
      "heading2": {
        "class": ".type-heading-2",
        "description": "Section headings (responsive)",
        "properties": {
          "family": "--type-family-heading",
          "size": "lg (24px) → 3xl (36px) at md",
          "weight": "bold (700)",
          "leading": "tight (1.2)",
          "tracking": "tight (-0.025em)"
        }
      },
      "heading3": {
        "class": ".type-heading-3",
        "description": "Subsection headings (responsive)",
        "properties": {
          "family": "--type-family-heading",
          "size": "lg (24px) → 2xl (32px) at md",
          "weight": "bold (700)",
          "leading": "tight (1.2)",
          "tracking": "tight (-0.025em)"
        }
      },
      "heading4": {
        "class": ".type-heading-4",
        "description": "Small headings, card titles (fixed)",
        "properties": {
          "family": "--type-family-heading",
          "size": "md (20px)",
          "weight": "bold (700)",
          "leading": "tight (1.2)",
          "tracking": "tight (-0.025em)"
        }
      },
      "caption": {
        "class": ".type-caption",
        "description": "Helper text, timestamps, metadata (includes muted color)",
        "properties": {
          "size": "2xs (12px)",
          "weight": "regular (400)",
          "leading": "normal (1.5)",
          "color": "--color-text-muted"
        }
      },
      "captionCompact": {
        "class": ".type-caption-compact",
        "description": "Compact captions for tight spaces (includes muted color)",
        "properties": {
          "size": "3xs (10px)",
          "weight": "regular (400)",
          "leading": "tight (1.2)",
          "color": "--color-text-muted"
        }
      },
      "code": {
        "class": ".type-code",
        "description": "Inline code and code blocks",
        "properties": {
          "size": "xs (14px)",
          "weight": "regular (400)",
          "leading": "normal (1.5)",
          "family": "--type-family-mono"
        }
      }
    },
    "legacy": {
      "_description": "DEPRECATED: Use --type-size-* primitives instead. These will be removed in a future version.",
      "sizes": {
        "2xs": { "value": "--text-2xs", "size": "0.75rem (12px)" },
        "xs": { "value": "--text-xs", "size": "0.875rem (14px)" },
        "sm": { "value": "--text-sm", "size": "1rem (16px)" },
        "md": { "value": "--text-md", "size": "1.25rem (20px)" },
        "lg": { "value": "--text-lg", "size": "1.5rem (24px)" },
        "xl": { "value": "--text-xl", "size": "1.75rem (28px)" },
        "2xl": { "value": "--text-2xl", "size": "2rem (32px)" },
        "3xl": { "value": "--text-3xl", "size": "2.25rem (36px)" },
        "4xl": { "value": "--text-4xl", "size": "2.5rem (40px)" },
        "5xl": { "value": "--text-5xl", "size": "2.75rem (44px)" },
        "6xl": { "value": "--text-6xl", "size": "3rem (48px)" }
      }
    }
