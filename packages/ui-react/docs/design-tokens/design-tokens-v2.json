    "actions": {
      "_description": "Action colors with base, foreground (-fg), and background (-bg) variants. The -fg variant is for text on neutral backgrounds, -bg is for subtle background fills.",
      "success": {
        "base": {
          "value": "--color-success",
          "description": "Success indicator. Confirmations, completed states."
        },
        "fg": {
          "value": "--color-success-fg",
          "description": "Success text on neutral backgrounds."
        },
        "bg": {
          "value": "--color-success-bg",
          "description": "Success background fill. Subtle success containers."
        }
      },
      "error": {
        "base": {
          "value": "--color-error",
          "description": "Error indicator. Validation errors, destructive actions."
        },
        "fg": {
          "value": "--color-error-fg",
          "description": "Error text on neutral backgrounds."
        },
        "bg": {
          "value": "--color-error-bg",
          "description": "Error background fill. Alert containers."
        }
      },
      "caution": {
