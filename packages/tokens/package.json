{
  "name": "@levain/tokens",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./src/styles/*": {
      "import": "./src/styles/*",
      "require": "./src/styles/*"
    },
    "./src/styles/shared.css": "./src/styles/shared.css",
    "./generated/themes.css": "./generated/themes.css"
  },
  "scripts": {
    "build": "echo 'No build step - TypeScript source consumed directly'",
    "test": "jest --config jest.config.cjs",
    "generate-themes": "tsx scripts/generate.ts"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "@types/culori": "^4.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
