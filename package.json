{
  "name": "levain-ds",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "description": "levain DS: design tokens and React components. TypeScript source; consumers transpile it (smoke/ builds it as one would).",
  "scripts": {
    "test": "pnpm --filter './packages/*' test",
    "check:types": "tsc --noEmit -p packages/tokens && tsc --noEmit -p packages/ui-react",
    "build": "pnpm --filter @levain/smoke --filter @levain/demo build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
